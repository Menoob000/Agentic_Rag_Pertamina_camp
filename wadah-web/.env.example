# ─────────────────────────────────────────
# ITec-Ai — Wadah Web Environment
# Copy file ini ke .env dan sesuaikan nilainya
# ─────────────────────────────────────────

APP_NAME="ITec-Ai RKS System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=itec_rks
DB_USERNAME=itec_admin
DB_PASSWORD=secret_password_change_me

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Zona Dapur (AI Microservice)
DAPUR_AI_URL=http://dapur-ai:8000
DAPUR_AI_TIMEOUT=300
